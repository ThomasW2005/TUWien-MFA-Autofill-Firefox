{
  "manifest_version": 3,
  "name": "TU Wien Automatic Login",
  "version": "1.1.0",
  "description": "Automatically fill and submit TU Wien login and TOTP forms.",
  "permissions": [
    "storage"
  ],
  "background": {
    "scripts": [
      "compat.js",
      "core.js",
      "background.js"
    ],
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tuwien.ac.at/*",
        "https://*.tuwien.at/*"
      ],
      "js": [
        "compat.js",
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tuwien-auto-login@local.extension",
      "update_url": "https://thomasw2005.github.io/TUWien-MFA-Autofill-Firefox/updates.json",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "140.0"
    }
  },
  "minimum_chrome_version": "121",
  "host_permissions": [
    "https://*.tuwien.ac.at/*",
    "https://*.tuwien.at/*"
  ],
  "action": {
    "default_title": "TU Wien login settings"
  }
}
